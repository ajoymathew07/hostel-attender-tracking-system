<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.13</version>
    <relativePath/>
  </parent>

  <groupId>in.ac.iitm.hostel</groupId>
  <artifactId>duty-tracker</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>duty-tracker</name>
  <description>Hostel Complaint and Duty Tracking System — Cauvery Hostel, IIT Madras</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Overrides the version managed by spring-boot-dependencies. -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <archunit.version>1.4.2</archunit.version>
    <jacoco.version>0.8.13</jacoco.version>
    <google-api-sheets.version>v4-rev20250603-2.0.0</google-api-sheets.version>
    <google-auth.version>1.48.0</google-auth.version>
    <shedlock.version>6.6.0</shedlock.version>
    <web-push.version>5.1.1</web-push.version>
    <bouncycastle.version>1.80</bouncycastle.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web layer: controllers, DTOs, Thymeleaf views (§2.4). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      Identity: Google OIDC and nothing else (ADR-002). There is deliberately no password
      encoder, no form login and no credential column anywhere — `spring-boot-starter-security`
      is here for the filter chain and method security, `oauth2-client` for the one sign-in
      mechanism the design allows.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>

    <!--
      Health check for the hosting platform (§2.7). Exactly one endpoint is exposed —
      `/actuator/health` — and it answers with a bare status; see the `management` block in
      application.yml and ActuatorExposureIntegrationTest.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Infrastructure: JPA repositories over PostgreSQL only (ADR-001). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Infrastructure: the Google Sheets adapter (sections 2.2, 5.3).

      `google-api-services-sheets` is the generated v4 client; `google-auth-library-oauth2-http`
      turns the base64 service-account JSON of section 11.5 into the credential it signs requests
      with. Both are reached from exactly one class, `GoogleApiSheetReader`, so the rest of the
      application — and every test — stays free of them.
    -->
    <dependency>
      <groupId>com.google.apis</groupId>
      <artifactId>google-api-services-sheets</artifactId>
      <version>${google-api-sheets.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
      <version>${google-auth.version}</version>
    </dependency>

    <!--
      A database-backed lock around the scheduled poll, so two instances cannot double-ingest
      (architecture section 2.5, point 4). The JDBC provider is chosen because the one database
      is already the single source of truth (section 2.6); a second piece of infrastructure just
      to hold a lock would be the wrong trade at this scale.
    -->
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-spring</artifactId>
      <version>${shedlock.version}</version>
    </dependency>
    <dependency>
      <groupId>net.javacrumbs.shedlock</groupId>
      <artifactId>shedlock-provider-jdbc-template</artifactId>
      <version>${shedlock.version}</version>
    </dependency>

    <!--
      Web Push to attender phones (ADR-011). The library signs with VAPID and encrypts the payload
      (aes128gcm); it needs Bouncy Castle as its crypto provider. Reached only from WebPushClient.
    -->
    <dependency>
      <groupId>nl.martijndwars</groupId>
      <artifactId>web-push</artifactId>
      <version>${web-push.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <!-- Test: JUnit 5, AssertJ, Mockito. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Test: `@WithMockUser` for every authorization test. The authorization-code flow itself is
      Spring Security's code and is not re-tested; what we wrote — the allowlist decision — is
      unit-tested directly (test plan section 12.1, ADR-002).
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test: every database test runs against real PostgreSQL (§12.1). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test: layering rules of §2.4, enforced continuously. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Coverage gates of test plan section 12.1, switched on in PR 2 now that there is
        real code to cover: 75% line overall, 90% line on `domain`.

        The two are separate `check` executions rather than one, because "90% on domain"
        is a statement about the domain layer as a whole. A PACKAGE-element rule would
        instead demand 90% from each domain package independently, which is a stricter
        and different promise than the design makes.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>

          <!-- 75% line coverage across the whole module. -->
          <execution>
            <id>jacoco-check-overall</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.75</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>

          <!-- 90% line coverage on the domain layer, aggregated across all modules. -->
          <execution>
            <id>jacoco-check-domain</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <includes>
                <include>duty/*/domain/*.class</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
